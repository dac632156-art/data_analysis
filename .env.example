# ===== DataMind AI 环境变量示例 =====
# 复制本文件为 .env 后按需修改（.env 已被 .gitignore 忽略，不会进入 git）。

# 上传大小限制（MB）。本地开发可调大（如 5120=5GB）以跑大文件；
# 生产环境不设置此值或由线上 .env.production 控制，默认 30MB。
MAX_UPLOAD_SIZE_MB=30

# SQLite 数据库文件路径（持久化存储，替代原内存+临时pickle）。
# 相对路径基于项目根目录；也可填绝对路径。
# 解耦部署时可改为独立服务器上的绝对路径（但 SQLite 为文件级，无法跨网络远程连，
# 仅支持"本机/同机"访问——这是 SQLite 的固有特性，详见 docs/db_distribution.md）。
DB_PATH=data/app.db
