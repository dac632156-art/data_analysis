/* MedicalDashboard - V2 数据看板（按计划改造）
   固定两列布局：左侧 AI 洞察摘要 + 右侧 AnalysisPackage 分析区块
   删除：4 Tab 导航 / 自动环图 / 自动雷达图 / 自动生成图表 */
import React from 'react';
import VisualizationRenderer from '../VisualizationRenderer';
import type { AnalysisPackage } from '../../types/api';

interface KPI { title: string; value: string | number; unit?: string; color?: string; change?: number | null; trend?: 'up' | 'down' | 'flat'; }

interface Props {
  kpis?: KPI[];
  /** V2：从分析引擎保存的分析包（唯一数据源） */
  packages?: AnalysisPackage[];
  title?: string;
}

const cardStyle: React.CSSProperties = {
  background: 'rgba(34,211,238,0.03)',
  border: '1px solid rgba(34,211,238,0.08)',
  borderRadius: '8px',
};

export default function MedicalDashboard({ kpis = [], packages, title = '数据看板' }: Props) {
  const hasPackages = packages && packages.length > 0;
  const hasKPIs = kpis.length > 0;

  return (
    <div className="big-screen w-full h-full flex flex-col overflow-auto"
      style={{ background: 'linear-gradient(135deg, #020518 0%, #060d2a 50%, #0a0a1e 100%)' }}>

      {/* 顶部标题栏 */}
      <div className="relative flex items-center justify-between px-6 py-3 border-b border-[#1a1f3a]/50">
        <div className="flex items-center gap-3">
          <div className="w-2 h-6 bg-gradient-to-b from-[#22d3ee] to-[#8b5cf6] rounded-full" />
          <h1 className="text-lg font-bold text-white tracking-wider"
            style={{ textShadow: '0 0 20px rgba(34,211,238,0.4)' }}>
            {title}
          </h1>
        </div>
      </div>

      {/* KPI 数字卡（如果有传入） */}
      {hasKPIs && (
        <div className="px-6 py-3 border-b border-[#1a1f3a]/30">
          <div className="grid grid-cols-5 gap-3">
            {kpis.slice(0, 5).map((kpi, i) => {
              const color = kpi.color || '#22d3ee';
              const numVal = typeof kpi.value === 'number' ? kpi.value : parseFloat(String(kpi.value));
              const isNum = !isNaN(numVal);
              return (
                <div key={i} className="p-3 rounded-lg" style={cardStyle}>
                  <div className="flex items-center gap-2">
                    <div className="text-lg">📊</div>
                    <div className="flex-1 min-w-0">
                      <p className="text-[9px] text-slate-500 uppercase tracking-wider">{kpi.title}</p>
                      <p className="text-base font-bold font-mono" style={{ color, textShadow: `0 0 10px ${color}40` }}>
                        {isNum ? numVal.toLocaleString() : kpi.value}
                      </p>
                      {kpi.unit && <span className="text-[9px] text-slate-500">{kpi.unit}</span>}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* 主体内容：两列布局 */}
      <div className="flex-1 flex gap-4 p-4 overflow-hidden">
        {/* 左列：AI 洞察摘要 */}
        <div className="w-72 flex-shrink-0 flex flex-col gap-3 overflow-auto">
          <div className="p-4 rounded-lg" style={{ ...cardStyle, background: 'rgba(139,92,246,0.04)', borderColor: 'rgba(139,92,246,0.1)' }}>
            <h3 className="text-xs font-semibold text-[#8b5cf6] mb-2">🤖 AI 洞察摘要</h3>
            {hasPackages && packages![0].insights && packages![0].insights.length > 0 ? (
              <div className="space-y-2">
                {packages![0].insights!.map((insight, i) => (
                  <p key={i} className="text-[11px] text-slate-300 leading-relaxed">{insight}</p>
                ))}
              </div>
            ) : hasPackages && packages![0].conclusions && packages![0].conclusions.length > 0 ? (
              <div className="space-y-1">
                {packages![0].conclusions!.map((c, i) => (
                  <p key={i} className="text-[11px] text-slate-300 leading-relaxed">
                    <span className="text-[#8b5cf6] font-semibold">{i + 1}.</span> {c}
                  </p>
                ))}
              </div>
            ) : (
              <p className="text-[11px] text-slate-500">暂无洞察数据，请先运行分析</p>
            )}
          </div>

          {/* 分析类型标签 */}
          {hasPackages && (
            <div className="p-3 rounded-lg" style={cardStyle}>
              <h3 className="text-xs font-semibold text-[#22d3ee] mb-2">📋 分析概览</h3>
              <div className="space-y-2">
                {packages!.slice(0, 3).map((pkg, i) => (
                  <div key={pkg.id || i} className="text-[11px]">
                    <div className="flex items-center gap-2 mb-1">
                      <span className="px-1.5 py-0.5 rounded text-[9px] font-semibold bg-[#8b5cf6]/20 text-[#a78bfa]">
                        {pkg.analysis_type}
                      </span>
                      <span className="text-slate-400">#{i + 1}</span>
                    </div>
                    <p className="text-slate-300 truncate">{pkg.business_question}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* 数据概况 */}
          <div className="p-3 rounded-lg" style={cardStyle}>
            <h3 className="text-xs font-semibold text-slate-400 mb-2">📊 数据概况</h3>
            <div className="space-y-1 text-[11px] text-slate-400">
              <p>分析包数量：<span className="text-[#22d3ee] font-mono">{hasPackages ? packages!.length : 0}</span></p>
              {hasPackages && (
                <>
                  <p>总 KPI 数：<span className="text-[#22d3ee] font-mono">
                    {packages!.reduce((s, p) => s + (p.kpis?.length || 0), 0)}
                  </span></p>
                  <p>总图表数：<span className="text-[#22d3ee] font-mono">
                    {packages!.reduce((s, p) => s + (p.charts?.length || 0), 0)}
                  </span></p>
                  <p>总表格数：<span className="text-[#22d3ee] font-mono">
                    {packages!.reduce((s, p) => s + (p.tables?.length || 0), 0)}
                  </span></p>
                </>
              )}
            </div>
          </div>
        </div>

        {/* 右列：主分析区域（AnalysisPackage 区块） */}
        <div className="flex-1 overflow-auto pr-1">
          {hasPackages ? (
            <div className="space-y-4">
              {packages!.map((pkg, index) => (
                <div key={pkg.id || index} className="p-4 rounded-lg" style={{ ...cardStyle, background: 'rgba(10,22,40,0.4)' }}>
                  {/* 区块标题 */}
                  <div className="flex items-center gap-3 mb-3 pb-2 border-b border-[#1a1f3a]/40">
                    <span className="px-2 py-0.5 rounded text-[10px] font-semibold bg-[#22d3ee]/20 text-[#22d3ee]">
                      {pkg.analysis_type}
                    </span>
                    <span className="text-xs text-slate-400">#{index + 1}</span>
                    <span className="text-sm text-slate-200 font-medium flex-1 truncate">{pkg.business_question}</span>
                    {!pkg.can_run && (
                      <span className="px-2 py-0.5 rounded text-[10px] font-semibold bg-[#f59e0b]/20 text-[#f59e0b]">
                        未执行
                      </span>
                    )}
                  </div>

                  {/* 使用 VisualizationRenderer 渲染 package 内容 */}
                  <VisualizationRenderer packages={[pkg]} selectedPackageIndex={0} />
                </div>
              ))}
            </div>
          ) : (
            /* 无 package 时的引导文字 */
            <div className="flex flex-col items-center justify-center h-full text-slate-500">
              <div className="text-4xl mb-4">📊</div>
              <p className="text-sm font-medium text-slate-400 mb-2">暂无分析结果</p>
              <p className="text-xs text-slate-600 text-center max-w-md">
                请先在「数据洞察」页面生成分析计划并执行，保存分析结果后，这里将展示您的分析看板。
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
